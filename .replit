modules = ["nodejs-20", "python-3.11", "web"]
run = "npm run dev"

[nix]
channel = "stable-24_05"
packages = ["nix-output-monitor"]

[deployment]
run = ["sh", "-c", "npm run dev"]

[workflows]
runButton = "Run"

[[workflows.workflow]]
name = "Run"
author = 36874920
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd builder-skill-showcase && npm run dev"

[[ports]]
localPort = 8080
externalPort = 80
