modules = ["nodejs-20", "python-3.11", "web"]
run = "npm run dev"

[nix]
channel = "stable-24_05"
packages = ["nix-output-monitor", "postgresql_12"]

[deployment]
run = ["sh", "-c", "cd builder-skill-showcase && npm run dev"]
deploymentTarget = "cloudrun"

[workflows]
runButton = "Run"

[[workflows.workflow]]
name = "Run"
author = 36874920
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd builder-skill-showcase && npm run dev"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd builder-skill-showcase && python new_scoring.py"

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 8083
externalPort = 3001

[[ports]]
localPort = 8084
externalPort = 3002
