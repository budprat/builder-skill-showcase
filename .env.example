# Supabase Configuration
# Get these values from your Supabase project dashboard: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Test Account Credentials (Optional - for development/testing only)
# DO NOT use real credentials here. These are for the DebugAuth component.
VITE_TEST_EMAIL=test@example.com
VITE_TEST_PASSWORD=your-test-password-here
